---
import { FAQS } from '@/data/site';
import { Plus } from '@lucide/astro';
---

<section id="faq" class="scroll-mt-24 border-t border-seam/60 py-20 lg:py-28">
  <div class="mx-auto max-w-[1240px] px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div class="reveal lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow flex items-center gap-2.5">
          <span class="inline-block h-px w-6 bg-brass"></span>
          Straight answers
        </p>
        <h2 class="mt-5 text-[2rem] leading-[1.08] sm:text-[2.4rem]">
          The questions people actually ask on the call.
        </h2>
        <p class="mt-5 text-[0.9375rem] leading-[1.72] text-chalk-dim">
          Answered here so you can decide in your own time rather than being
          talked round on the phone.
        </p>
      </div>

      <!-- Native <details>: zero JS, keyboard-accessible, findable with ctrl-F. -->
      <div class="reveal divide-y divide-seam border-y border-seam">
        {
          FAQS.map((faq) => (
            <details class="group">
              <summary
                class="flex cursor-pointer list-none items-start gap-5 py-5 text-left [&::-webkit-details-marker]:hidden"
              >
                <h3 class="flex-1 font-display text-[1.0625rem] font-normal leading-snug text-chalk transition-colors group-hover:text-brass-lift sm:text-[1.1875rem]">
                  {faq.q}
                </h3>
                <span
                  class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full border border-seam text-mist transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:border-brass group-hover:text-brass group-open:rotate-45 group-open:border-brass group-open:text-brass"
                >
                  <Plus size={13} aria-hidden="true" />
                </span>
              </summary>
              <p class="max-w-2xl pb-6 pr-11 text-[0.875rem] leading-[1.78] text-chalk-dim">
                {faq.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

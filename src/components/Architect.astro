---
import { ARCHITECT, BRAND } from '@/data/site';
import { IMAGES } from '@/data/images';
import { unsplash, unsplashSrcSet } from '@/lib/images';
---

<section id="architect" class="scroll-mt-24 border-t border-seam/60 py-20 lg:py-28">
  <div class="mx-auto max-w-[1240px] px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16">
      <!-- ------- Portrait ------- -->
      <figure class="reveal lg:sticky lg:top-28 lg:self-start">
        <div class="relative overflow-hidden rounded-sm bg-ink-2">
          <img
            src={unsplash(IMAGES.coach.id, { w: 900, ratio: 4 / 5 })}
            srcset={unsplashSrcSet(IMAGES.coach.id, [500, 700, 900, 1200], 4 / 5)}
            sizes="(min-width: 1024px) 400px, 100vw"
            alt={IMAGES.coach.alt}
            loading="lazy"
            decoding="async"
            class="aspect-[4/5] w-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-ink via-transparent to-transparent opacity-80"></div>

          <figcaption class="absolute inset-x-0 bottom-0 p-5">
            <p class="font-display text-[1.25rem] leading-none text-chalk">{BRAND.coach}</p>
            <p class="mt-1.5 font-mono text-[0.5625rem] uppercase tracking-[0.16em] text-brass">
              Founder &amp; head coach
            </p>
          </figcaption>
        </div>

        <ul class="mt-5 divide-y divide-seam border-y border-seam">
          {
            ARCHITECT.credentials.map((c) => (
              <li class="py-2.5 text-[0.75rem] leading-snug text-mist">{c}</li>
            ))
          }
        </ul>
      </figure>

      <!-- ------- Narrative ------- -->
      <div class="reveal">
        <p class="eyebrow flex items-center gap-2.5">
          <span class="inline-block h-px w-6 bg-brass"></span>
          {ARCHITECT.eyebrow}
        </p>

        <h2 class="mt-5 text-[1.85rem] leading-[1.1] sm:text-[2.35rem]">
          {ARCHITECT.title}
        </h2>

        <p class="mt-5 font-display text-[1.2rem] font-light italic leading-snug text-brass sm:text-[1.35rem]">
          {ARCHITECT.lede}
        </p>

        <div class="mt-8 space-y-5 border-l border-seam pl-6 sm:pl-8">
          {
            ARCHITECT.body.map((para) => (
              <p class="max-w-2xl text-[0.9375rem] leading-[1.8] text-chalk-dim">{para}</p>
            ))
          }
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a href="#apply" class="btn btn-ghost">Start the 2-minute qualifier</a>
          <p class="font-mono text-[0.5625rem] uppercase tracking-[0.14em] text-mist">
            {BRAND.facility}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

---
import { GUARANTEE, BRAND } from '@/data/site';
import { IMAGES } from '@/data/images';
import { unsplash } from '@/lib/images';
---

<section class="relative isolate overflow-hidden border-t border-seam/60">
  <div class="absolute inset-0 -z-10">
    <img
      src={unsplash(IMAGES.texture[0]?.id ?? IMAGES.hero.id, { w: 1600, ratio: 21 / 9 })}
      alt=""
      aria-hidden="true"
      loading="lazy"
      decoding="async"
      class="size-full object-cover opacity-[0.13]"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink via-ink/90 to-ink"></div>
  </div>

  <div class="mx-auto max-w-[1240px] px-5 py-20 sm:px-8 lg:py-28">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="eyebrow">{GUARANTEE.eyebrow}</p>

      <h2 class="mt-5 text-[2rem] leading-[1.08] sm:text-[2.75rem]">
        {GUARANTEE.title}
      </h2>

      <div class="tape-rule mx-auto mt-8 h-2 w-40 opacity-70"></div>

      <p class="mx-auto mt-8 max-w-xl text-[0.9375rem] leading-[1.8] text-chalk-dim">
        {GUARANTEE.body}
      </p>

      <div class="mt-10 flex flex-col items-center gap-3">
        <a href="#apply" class="btn btn-primary w-full sm:w-auto">
          Start 2-minute qualifier
        </a>
        <p class="font-mono text-[0.5625rem] uppercase tracking-[0.14em] text-mist">
          <span class="tnum">{BRAND.spacesLeft}</span> of <span class="tnum">{BRAND.spacesTotal}</span> spaces remaining · {BRAND.intake}
        </p>
      </div>
    </div>
  </div>
</section>

---
import '@/styles/global.css';
import { BRAND } from '@/data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://surreyeliteperformance.co.uk');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: BRAND.name,
  description,
  url: canonical.href,
  telephone: BRAND.phone,
  email: BRAND.email,
  priceRange: '£££',
  areaServed: ['Guildford', 'Cobham', 'Weybridge', 'Esher', 'Surrey'].map((n) => ({
    '@type': 'City',
    name: n,
  })),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Guildford',
    addressRegion: 'Surrey',
    addressCountry: 'GB',
  },
  founder: { '@type': 'Person', name: BRAND.coach },
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" content="#0c0f16" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300&family=Instrument+Sans:wght@400;500;600&family=Martian+Mono:wght@400;600&display=swap"
    />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

    <!-- Arms the scroll-reveal styles before first paint. Without JS the
         content stays visible instead of being stuck at opacity 0. -->
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>
  </head>

  <body>
    <a
      href="#apply"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-sm focus:bg-claret focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
    >
      Skip to the application
    </a>

    <slot />

    <script>
      import Lenis from 'lenis';

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ---- Smooth inertia scrolling ---- */
      if (!reduced) {
        const lenis = new Lenis({
          duration: 1.05,
          easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          smoothWheel: true,
        });

        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);

        /* Anchor links must go through Lenis or they fight it. */
        document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
          link.addEventListener('click', (event) => {
            const id = link.getAttribute('href');
            if (!id || id === '#') return;
            const target = document.querySelector(id);
            if (!target) return;
            event.preventDefault();
            lenis.scrollTo(target as HTMLElement, { offset: -80 });
          });
        });
      }

      /* ---- Shared scroll-reveal observer ---- */
      const revealables = document.querySelectorAll('.reveal');
      if (reduced) {
        revealables.forEach((el) => el.classList.add('is-in'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );
        revealables.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
